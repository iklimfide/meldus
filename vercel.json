{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/en",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/panel",
      "destination": "/meldus/",
      "permanent": true
    },
    {
      "source": "/panel/",
      "destination": "/meldus/",
      "permanent": true
    }
  ]
}
